# Local development defaults to a persistent local account database and SAMPLE odds.
# Copy this file to .env.local. Never commit actual secrets.
# Hosted accounts require all three Supabase values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional dedicated browser-session encryption secret, at least 32 characters.
# Hosted environments otherwise derive a separate key from the private service key.
# Local development creates a private persistent key inside BETER_DATA_DIR.
BETER_SESSION_SECRET=

# Set live explicitly AFTER adding the odds provider key.
# Hosted deployments default to live; they never silently use sample data.
BETER_DATA_MODE=sample
# Hosted sample mode requires staging. Use production for a public live release.
BETER_ENVIRONMENT=development
ODDS_API_KEY=
ODDS_BOOKMAKER=draftkings

# Set to the real HTTPS origin when deploying. Additional allowed frontend origins
# may be comma-separated; omit a trailing slash.
SITE_URL=http://127.0.0.1:4173
ALLOWED_ORIGINS=http://127.0.0.1:4173

# Generate a private random worker secret with at least 32 characters.
# Configure the same secret in Supabase Vault for the scheduled job.
JOB_SECRET=

# Public account destinations. Configure real, working HTTPS destinations before
# a public release. The account deletion URL must initiate the supported process.
BETER_SUPPORT_URL=
BETER_PRIVACY_URL=
BETER_ACCOUNT_DELETION_URL=

# Operator/monitor CLI only; never exposed to the browser. Supply JOB_SECRET
# privately through the process environment rather than a command-line argument.
BETER_OPS_URL=

# Local development only. Production never uses this database.
BETER_DATA_DIR=.data/postgres
