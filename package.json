{
  "name": "beter-practice",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node serve.mjs",
    "dev": "node serve.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='server/*.ts' --test-coverage-include='dist/api-client.js' --test-coverage-include='dist/engine.js' --test-coverage-include='dist/markets.js' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:install-browsers": "playwright install chromium firefox webkit",
    "test:postgres": "node --test tests/postgres-race.integration.mjs",
    "ops": "node scripts/ops.mjs",
    "typecheck": "node scripts/build-edge.mjs && tsc --noEmit",
    "build": "npm run typecheck",
    "aws:package": "node scripts/aws-package.mjs",
    "aws:deploy": "node scripts/aws-deploy.mjs",
    "aws:publish": "node scripts/aws-publish.mjs",
    "aws:migrate": "node scripts/aws-migrate.mjs",
    "aws:check": "node scripts/aws-hosted-checks.mjs",
    "aws:ops": "node scripts/aws-operations-checks.mjs",
    "test:aws:postgres": "node --test tests/aws-auth-race.integration.mjs",
    "test:aws:scram": "node --test tests/aws-scram.integration.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1174.0",
    "@aws-sdk/client-rds-data": "3.1174.0",
    "@aws-sdk/client-secrets-manager": "3.1174.0",
    "@aws-sdk/client-sns": "3.1174.0",
    "@electric-sql/pglite": "^0.5.17",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
